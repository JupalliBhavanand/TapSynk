# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Your public site address (no trailing slash). Used for links on NFC cards, emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # secret: server only, never expose

# Stripe → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Anthropic Console → API keys (powers the AI agent and website learning)
ANTHROPIC_API_KEY=

# Set to "false" while testing to make cards live without a paid plan.
NEXT_PUBLIC_REQUIRE_SUBSCRIPTION=true
