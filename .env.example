NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_VOICE=Kore
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
ADMIN_EMAILS=
NEXT_PUBLIC_REQUIRE_SUBSCRIPTION=true

# Gmail sender for appointment confirmations. Server-only, never NEXT_PUBLIC_.
# Enable Google 2-Step Verification and create an app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared company sender for ALL cards (preferred over legacy Gmail settings).
COMPANY_EMAIL=
COMPANY_EMAIL_NAME=TapSynk Appointments
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH_MODE=credentials
SMTP_USER=
SMTP_PASSWORD=
# Use SMTP_AUTH_MODE=relay with empty SMTP_USER/SMTP_PASSWORD only when
# your company relay explicitly authorizes this server/IP to send mail.
